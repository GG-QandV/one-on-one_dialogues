# speech-local — переменные окружения
# Копировать в .env, заполнить реальными значениями.
# Права на .env: 0600 (содержит ключи).
#
# --- Провайдеры перевода ---
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# --- Локация данных ---
# По умолчанию — data/ в корне проекта.
SPEECH_DATA_DIR=

# --- Логирование ---
# debug | info | warning | error
LOG_LEVEL=info

# --- UI ---
# По умолчанию 127.0.0.1:8790
UI_HOST=127.0.0.1
UI_PORT=8790

# --- BYOK (Bring Your Own Key) ---
# Путь к keystore-файлу с мастер-ключом.
BYOK_KEYSTORE_PATH=
